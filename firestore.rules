rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomDoc(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }
    function isGm(code) { return signedIn() && roomDoc(code).gmUid == request.auth.uid; }

    // Phones send their own clock + 7 days; between 1 and 30 days ahead covers a clock up to 6 days slow or 23 days fast.
    // The lower bound keeps a record from expiring within hours of being written.
    function validExpiry(t) { return t is timestamp && t > request.time + duration.value(1, 'd') && t < request.time + duration.value(30, 'd'); }

    // expiresAt is optional so pages opened before this rule keep working; when present it must be sane.
    function optionalExpiry(d) { return !('expiresAt' in d) || validExpiry(d.expiresAt); }
    // A room's own expiresAt must be more than 12 hours ahead (a game master with a slow clock must not write one about to go).
    function roomExpiry(d) { return !('expiresAt' in d) || (d.expiresAt is timestamp && d.expiresAt > request.time + duration.value(12, 'h')); }

    match /rooms/{code} {
      allow get: if signedIn();
      // The lock outlives every record under the room, so a used code cannot be created again.
      allow create: if signedIn() && request.resource.data.gmUid == request.auth.uid
        && roomExpiry(request.resource.data)
        && !exists(/databases/$(database)/documents/rooms/$(code)/gm/lock);
      // An unchanged stamp passes: an older page never touches expiresAt, and the merged doc still carries it.
      allow update: if isGm(code)
        && (request.resource.data.get('expiresAt', null) == resource.data.get('expiresAt', null) || roomExpiry(request.resource.data));
      allow delete: if isGm(code);

      match /players/{uid} {
        allow read: if signedIn();
        function validName() {
          return request.resource.data.keys().hasOnly(['name', 'joinedAt', 'expiresAt', 'votedRound'])
            && (!('votedRound' in request.resource.data) || request.resource.data.votedRound is int)
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 20;
        }
        allow create: if signedIn() && request.auth.uid == uid && validName() && optionalExpiry(request.resource.data)
          && request.resource.data.joinedAt == request.time
          // existsAfter: createRoom writes the room and the host's record in one commit.
          && existsAfter(/databases/$(database)/documents/rooms/$(code));
        allow update: if signedIn() && request.auth.uid == uid && validName()
          && request.resource.data.joinedAt == resource.data.joinedAt
          // Unchanged (a rename; get() so a doc written before expiry existed may have none), or a new valid expiry.
          && (request.resource.data.get('expiresAt', null) == resource.data.get('expiresAt', null)
            || ('expiresAt' in request.resource.data && validExpiry(request.resource.data.expiresAt)));
        allow delete: if signedIn() && (request.auth.uid == uid || isGm(code));
      }

      match /private/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isGm(code));
        allow write: if isGm(code);
      }

      match /gm/{docId} {
        allow read, create, update: if isGm(code);
        // The lock keeps a used code from being created again: not even the game master may delete it.
        allow delete: if isGm(code) && docId != 'lock';
      }

      match /votes/{id} {
        allow read: if isGm(code);
        allow get: if signedIn() && id.split('_')[1] == request.auth.uid;
        allow create: if signedIn()
          && id == string(roomDoc(code).round) + '_' + request.auth.uid
          && roomDoc(code).phase == 'voting'
          && request.auth.uid in roomDoc(code).roundPlayers
          && request.resource.data.target in roomDoc(code).roundPlayers
          && request.resource.data.target != request.auth.uid
          && request.resource.data.keys().hasOnly(['target', 'round', 'expiresAt'])
          && request.resource.data.round == roomDoc(code).round
          && optionalExpiry(request.resource.data);
      }
    }
  }
}
