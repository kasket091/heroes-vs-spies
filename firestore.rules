rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomDoc(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }
    function isGm(code) { return signedIn() && roomDoc(code).gmUid == request.auth.uid; }

    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.gmUid == request.auth.uid;
      allow update: if isGm(code);

      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 20;
        allow delete: if signedIn() && (request.auth.uid == uid || isGm(code));
      }

      match /private/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isGm(code));
        allow write: if isGm(code);
      }

      match /gm/{docId} {
        allow read, write: if isGm(code);
      }

      match /votes/{id} {
        allow read: if isGm(code);
        allow create: if signedIn()
          && id == string(roomDoc(code).round) + '_' + request.auth.uid
          && roomDoc(code).phase == 'voting'
          && request.auth.uid in roomDoc(code).roundPlayers
          && request.resource.data.target in roomDoc(code).roundPlayers
          && request.resource.data.target != request.auth.uid;
      }
    }
  }
}
